# ============================================================
# PedusGPT — Variables de entorno (copia este archivo a .env)
# NUNCA subas el archivo .env a GitHub.
# ============================================================

# --- Groq (https://console.groq.com/keys) ---
GROQ_API_KEY=gsk_tu_clave_de_groq

# --- Supabase (Project Settings → API Keys) ---
# Valen las claves nuevas (sb_publishable_... / sb_secret_...) o las antiguas (anon / service_role "eyJ...").
# SUPABASE_ANON_KEY = publishable (o anon) · SUPABASE_SERVICE_KEY = secret (o service_role)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu_anon_key_publica
SUPABASE_SERVICE_KEY=tu_service_role_key_secreta
# Opcional (solo proyectos con "Legacy JWT secret"). En proyectos nuevos déjalo VACÍO:
# los tokens se verifican con la API de Supabase Auth.
SUPABASE_JWT_SECRET=

# --- Roles ---
# Email del propietario (owner). Al iniciar sesión con este email se le asigna el rol owner.
OWNER_EMAIL=tu-email@ejemplo.com
# Email al que llegan las solicitudes del Plan MAX
CONTACT_EMAIL=equipo@pedusia.com
ULTRA_DAILY_LIMIT=30

# --- Mistral (opcional): respaldo si Groq falla y modelo principal de PRO ULTRA ---
# Clave gratis (sin tarjeta) en https://console.mistral.ai/api-keys
# Vacía = PedusGPT usa solo Groq (los modelos "mistral:..." se saltan solos).
MISTRAL_API_KEY=
# Tokens por minuto de cada modelo de Mistral en tu cuenta (modo gratis: ~20000)
MISTRAL_TPM_LIMIT=20000

# --- Búsqueda web automática (opcional) ---
# Tavily (principal, 1.000 búsquedas/mes gratis): https://app.tavily.com
# Exa (respaldo, crédito mensual gratis): https://dashboard.exa.ai
# Sin ninguna de las dos claves, la búsqueda web queda desactivada.
TAVILY_API_KEY=
EXA_API_KEY=
WEB_SEARCH_ENABLED=true
# Respuestas con búsqueda al día para user/max/admin (el owner no tiene límite)
WEB_SEARCH_DAILY_LIMIT=30
# Consultas por mensaje (cada una gasta 1 crédito), resultados por consulta y caracteres al contexto
WEB_SEARCH_MAX_QUERIES=2
WEB_SEARCH_RESULTS=5
WEB_SEARCH_CONTEXT_CHARS=6000

# --- Modelos (cadenas de respaldo separadas por comas) ---
# Se usa el primero disponible; si falla (no existe, saturado, proveedor caído) se pasa al siguiente.
# "modelo" = Groq · "mistral:modelo" = Mistral. Normalmente NO hace falta definirlas:
# déjalas comentadas para usar los valores recomendados.
# GROQ_MODEL_BASIC=openai/gpt-oss-20b,qwen/qwen3.8-27b,mistral:mistral-small-latest
# GROQ_MODEL_PRO=openai/gpt-oss-120b,mistral:mistral-medium-latest,qwen/qwen3.8-27b
# GROQ_MODEL_ULTRA=mistral:mistral-large-4,mistral:mistral-medium-latest,openai/gpt-oss-120b,qwen/qwen3.8-27b
# GROQ_MODEL_TITLE=openai/gpt-oss-20b,mistral:ministral-8b-latest,qwen/qwen3.8-27b
# Modelo con visión para imágenes adjuntas (vacío = desactivado)
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Respaldo de dictado por voz (navegadores sin Web Speech API)
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_MAX_TOKENS=4096
GROQ_TEMPERATURE=0.7

# --- PedusCode (agente de código, solo Plan MAX) ---
# Ejecuciones al día para MAX y Admin (el owner no tiene límite)
PEDUSCODE_DAILY_LIMIT=3
# Modelos del organizador y de los agentes (se reparten la carga entre todos)
# PEDUSCODE_PLANNER_MODELS=openai/gpt-oss-120b,mistral:mistral-medium-latest,openai/gpt-oss-20b
# PEDUSCODE_WORKER_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b,mistral:mistral-medium-latest
# Agentes como máximo además del organizador (1 + 9 = 10 llamadas a la IA)
PEDUSCODE_MAX_AGENTS=9
PEDUSCODE_WORKER_MAX_TOKENS=4000
# Tokens por minuto de tu cuenta de Groq para cada modelo (plan gratuito: 8000).
# Si pasas al plan Developer, súbelo y PedusCode irá mucho más rápido.
GROQ_TPM_LIMIT=8000

# --- Modo pensar y niveles de esfuerzo ---
# Modelos de los esfuerzos Ultra/UltraMAX (los más potentes), del revisor de UltraMAX
# y del selector automático de skills y de búsqueda web (rápido y barato)
# GROQ_MODEL_DEEP=mistral:mistral-large-4,openai/gpt-oss-120b,mistral:mistral-medium-latest,qwen/qwen3.8-27b
# GROQ_MODEL_REVIEW=mistral:mistral-medium-latest,qwen/qwen3.8-27b,openai/gpt-oss-20b
# GROQ_MODEL_ROUTER=openai/gpt-oss-20b,mistral:ministral-8b-latest,qwen/qwen3.8-27b
# Respuestas UltraMAX al día para MAX y Admin (cada una son 3 llamadas a la IA; el owner no tiene límite)
ULTRAMAX_DAILY_LIMIT=10
# Segundos máximos que se espera a un modelo saturado antes de probar el siguiente
GROQ_MAX_WAIT=40

# --- Skills (solo Plan MAX) ---
SKILLS_MAX_PER_USER=20
SKILLS_MAX_OWNER=100
# Caracteres máximos de skills que se añaden al contexto de cada respuesta
SKILL_CONTEXT_CHARS=12000
# Opcional: token de GitHub (sin permisos) para importar skills sin el límite de 60 peticiones/hora
GITHUB_TOKEN=

# --- Seguridad ---
# Orígenes permitidos por CORS (solo si sirves el frontend desde OTRO dominio)
ALLOWED_ORIGINS=
ENABLE_CSP=true

# --- Entorno: production | development ---
ENVIRONMENT=development

# --- SEO (opcional, solo en Render) ---
# Código de verificación de Google Search Console (método "Etiqueta HTML").
# Puedes pegar solo el código o la etiqueta <meta ...> entera.
# GOOGLE_SITE_VERIFICATION=
# URL pública si usas un dominio propio (en Render se detecta sola).
# PUBLIC_URL=https://www.tudominio.com
